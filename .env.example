MYSQL_DATABASE=namatdang
MYSQL_USER=namatdang
MYSQL_PASSWORD=local_password
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_PORT=3306
# LocalStack을 사용할 때만 true로 변경한다.
NOTIFICATION_SQS_ENABLED=false
NOTIFICATION_SQS_CONSUMER_ENABLED=false
NOTIFICATION_SQS_ENDPOINT=http://localhost:4566
NOTIFICATION_SQS_QUEUE_URL=http://localhost.localstack.cloud:4566/queue/ap-northeast-2/000000000000/namatdang-notification-events

# 실제 Firebase 발송 시에만 true로 변경한다.
NOTIFICATION_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# 실제 Registration Token 발송 테스트를 명시적으로 실행할 때만 설정한다.
RUN_FIREBASE_TESTS=false
FIREBASE_TEST_REGISTRATION_TOKEN=

JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 대표 이미지는 private S3 버킷에만 저장한다. 실제 배포 버킷 이름을 반드시 설정한다.
IMAGE_S3_BUCKET=
AWS_REGION=ap-northeast-2

# AWS 키를 파일에 저장하지 않는다. 실행 환경의 EC2/ECS IAM 역할에
# 대상 버킷 images/* 경로의 s3:GetObject, PutObject, DeleteObject 권한을 부여한다.
