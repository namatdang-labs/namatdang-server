MYSQL_DATABASE=namatdang
MYSQL_USER=namatdang
MYSQL_PASSWORD=local_password
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_PORT=3306

# LocalStack을 사용할 때만 true로 변경한다.
NOTIFICATION_SQS_ENABLED=false
NOTIFICATION_SQS_CONSUMER_ENABLED=false
NOTIFICATION_SQS_ENDPOINT=http://localhost:4566
NOTIFICATION_SQS_QUEUE_URL=http://localhost.localstack.cloud:4566/queue/ap-northeast-2/000000000000/namatdang-notification-events

# #13 및 Firebase Adapter 연결 전에는 false로 유지한다.
NOTIFICATION_PUSH_ENABLED=false
