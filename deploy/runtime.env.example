# EC2의 /opt/namatdang/app/runtime.env에 복사한 뒤 실제 환경값으로 바꾼다.
# DB 비밀번호와 JWT 키는 이 파일에 넣지 않는다.

TZ=Asia/Seoul
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=65.0 -Duser.timezone=Asia/Seoul

DB_URL=jdbc:mysql://replace-with-rds-endpoint:3306/namatdang?sslMode=VERIFY_IDENTITY&trustCertificateKeyStoreUrl=file:/run/certs/rds-truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit&fallbackToSystemTrustStore=false&serverTimezone=Asia/Seoul
DB_USERNAME=namatdang_app
SPRING_JPA_HIBERNATE_DDL_AUTO=update

JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
CORS_ALLOWED_ORIGINS=https://replace-with-frontend-domain

AWS_REGION=ap-northeast-2
NOTIFICATION_SQS_ENABLED=true
NOTIFICATION_SQS_CONSUMER_ENABLED=true
NOTIFICATION_SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/replace-with-account-id/namatdang-dev-notification-events

NOTIFICATION_PUSH_ENABLED=false

LOGGING_LEVEL_ORG_HIBERNATE_SQL=INFO
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_BIND=OFF
SERVER_FORWARD_HEADERS_STRATEGY=framework
